{
  "name": "@andares/pi-toolkits",
  "version": "0.7.2",
  "description": "Integrated toolkit extension for pi — ask mode (read-only Q&A), model favorites, prompt stash, third-party code review, and a dedicated compaction model",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andares/pi-toolkits.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "pi",
    "pi-extension",
    "ask-mode",
    "readonly",
    "model-favorites",
    "prompt-stash",
    "code-review",
    "compaction",
    "compact-model",
    "toolkit",
    "autostart"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.0 <2.0.0",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@dreki-gg/pi-command-sandbox": "^0.4.3",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:keybindings": "node ./scripts/check-keybindings.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test",
    "release": "node ./scripts/publish.mjs",
    "tag-current": "node ./scripts/tag-current.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
