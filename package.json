{
  "name": "@andares/pi-toolkits",
  "version": "1.0.0",
  "description": "Integrated toolkit extension for pi — ask mode (read-only Q&A), browser-reviewed planning, an acceptance ledger with a browser page, session-scoped permission checks, model favorites, prompt stash, third-party code review, session autostart, a dedicated compaction model, an agent memory framework (/ask-init), a quit watchdog, and release notes on the first start after an upgrade",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andares/pi-toolkits.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi",
    "pi-extension",
    "ask-mode",
    "readonly",
    "model-favorites",
    "prompt-stash",
    "code-review",
    "compaction",
    "compact-model",
    "toolkit",
    "autostart",
    "permission",
    "approval",
    "boundary",
    "agent-memory",
    "memory-framework",
    "scaffold",
    "init",
    "ask-init",
    "plan",
    "ask-plan",
    "uat",
    "ask-uat",
    "acceptance",
    "acceptance-testing",
    "change-record",
    "quit-guard",
    "watchdog",
    "whats-new",
    "release-notes",
    "changelog"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@dreki-gg/pi-command-sandbox": "^0.4.3",
    "shell-quote": "^1.12.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^1.5.1",
    "@earendil-works/pi-tui": "^1.5.1",
    "@types/node": "^26.6.2",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:keybindings": "node ./scripts/check-keybindings.mjs",
    "check:compat": "node ./scripts/check-compat.mjs",
    "approval-report": "node ./scripts/approval-report.mjs",
    "release:github": "node ./scripts/release-github.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm ui:typecheck && pnpm test && pnpm ui:check",
    "release": "node ./scripts/publish.mjs",
    "tag-current": "node ./scripts/tag-current.mjs",
    "ui:dev": "pnpm --filter @andares/pi-toolkits-ui dev",
    "ui:build": "pnpm --filter @andares/pi-toolkits-ui build",
    "ui:typecheck": "pnpm --filter @andares/pi-toolkits-ui typecheck",
    "ui:check": "pnpm ui:build && test -z \"$(git status --porcelain -- src/features/plan/assets src/features/uat/assets)\""
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
