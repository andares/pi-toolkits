{
  "name": "@andares/pi-toolkits-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser UIs: ask-plan review page and ask-uat acceptance page (built into their feature asset dirs)",
  "scripts": {
    "dev": "vite",
    "dev:uat": "vite -c vite.config.uat.ts",
    "build": "vite build && vite build -c vite.config.uat.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "solid-js": "^1.9.18",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.15"
  }
}
